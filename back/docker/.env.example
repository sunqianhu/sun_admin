APP_DEBUG=false
APP_JWT_KEY=replace_with_your_own_random_key

DB_TYPE=mysql
DB_HOST=mysql
DB_NAME=sun_admin
DB_USER=sun_admin
DB_PASS=""
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_PREFIX=

# 缓存：file、redis；队列：database、redis、sync
CACHE_DRIVER=file
QUEUE_DRIVER=database

MESSAGE_LISTEN_IP=0.0.0.0
MESSAGE_REQUEST_IP=127.0.0.1
MESSAGE_PORT=7001

# 使用宿主机 Redis 时填写
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=""
CACHE_REDIS_DB=0
QUEUE_REDIS_DB=1
