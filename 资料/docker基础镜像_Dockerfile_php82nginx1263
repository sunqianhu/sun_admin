#nginx
FROM php:8.2-fpm-alpine as nginx

RUN apk add --no-cache build-base wget openssl-dev pcre-dev zlib-dev \
	&& mkdir /soft \
	&& cd /soft \
	&& wget https://nginx.org/download/nginx-1.26.3.tar.gz \
	&& tar -zxvf nginx-1.26.3.tar.gz \
	&& cd nginx-1.26.3 \
	&& ./configure --prefix=/usr/local/nginx-1.26.3 --user=www-data --group=www-data --with-http_ssl_module \
	&& make \
	&& make install

#php
FROM php:8.2-fpm-alpine

#安装依赖
RUN apk add --no-cache pcre zip libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev supervisor \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql zip gd pcntl \
    && rm -rf /var/cache/apk/*

COPY --from=nginx /usr/local/nginx-1.26.3 /usr/local/nginx-1.26.3
COPY --from=composer:2.5.8 /usr/bin/composer /usr/bin/composer
RUN mkdir -p /var/log/nginx /var/log/supervisor \
    && chown -R www-data:www-data /var/log/nginx /var/log/supervisor \
	&& chown -R www-data:www-data /usr/local/nginx-1.26.3

#工作目录
WORKDIR /var/www/html